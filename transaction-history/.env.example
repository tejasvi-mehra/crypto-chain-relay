HOST="127.0.0.1"
PORT="8080"
SERVER_READ_TIMEOUT="15s"
SERVER_WRITE_TIMEOUT="15s"

# Logger
MODE=development
LOG_LEVEL=debug
LOG_ENCODING=console

# db/db.go
PGSSLMODE=disable
DB_URL=postgres://postgres:postgres@127.0.0.1:5432/transaction-history?sslmode=disable
DB_MAX_CONNECTION=5
DB_MIN_CONNECTION=1
DB_MAX_IDLE_TIME="15m"