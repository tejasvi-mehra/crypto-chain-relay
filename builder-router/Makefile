.PHONY: test pre-test-go test-go pre-commit pre-doc-go pre-generate pre-generate-go generate generate-go generate-doc generate-event build run-local db-migrate-create view-spec pre-check check
.DEFAULT_GOAL=test

SERVICE_NAME = builder-router

# test

test: test-go

pre-test-go:
	go install -mod=mod github.com/onsi/ginkgo/v2/ginkgo
	go install -mod=mod github.com/boumenot/gocover-cobertura

test-go:
	ginkgo run -r --race --keep-going --junit-report report.xml --cover --coverprofile cover.out

# build
pre-commit:
	go mod tidy
	go vet ./...
	go fmt ./...


build:
	env GOOS=$(TARGETOS) GOARCH=$(TARGETARCH) go build -o $(SERVICE_NAME)

# run and utils

run-local:
	$(shell export $$(grep -v '#' .env.local | xargs -I % echo -n '% ') && ./$(SERVICE_NAME))

db-migrate-create:
ifeq (,$(MIGRATION))
	@echo "please specific MIGRATION=<new migration filename>"
else
	migrate create -seq -ext sql -dir db/migrations $(MIGRATION)
endif

MIGRATION_USER ?= postgres
MIGRATION_PASSWORD ?= postgres
db-migrate-up-local:
	migrate -path db/migrations -database "postgres://$(MIGRATION_USER):$(MIGRATION_PASSWORD)@localhost:5432/$(SERVICE_NAME)?sslmode=disable" up
db-migrate-down-local:
	migrate -path db/migrations -database "postgres://$(MIGRATION_USER):$(MIGRATION_PASSWORD)@localhost:5432/$(SERVICE_NAME)?sslmode=disable" down

db-init:
	PGPASSWORD='$(MIGRATION_PASSWORD)' psql -h localhost -p 5432 -U $(MIGRATION_USER) -c 'CREATE DATABASE "$(SERVICE_NAME)"'

db-models:
	PGSSLMODE=disable tables-to-go -t pg -h postgres.postgres.svc.cluster.local -port 5432 -d $(SERVICE_NAME) -u $(MIGRATION_USER) -p $(MIGRATION_PASSWORD) -s public -of ./internal/database/generated -pn db -fn-format s -null native

db-test-data:
	PGPASSWORD='$(MIGRATION_PASSWORD)' psql -h localhost -p 5432 -U $(MIGRATION_USER) -d $(SERVICE_NAME) -f db/testdata/test_data.sql